generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                String     @id @default(uuid()) @db.Uuid
  email             String     @unique
  password          String
  full_name         String?
  phone_number      String?
  avatar_url        String?
  role              Role       @default(USER)
  is_active         Boolean    @default(true)
  deactivated_at    DateTime?  @db.Timestamptz
  is_email_verified Boolean    @default(false)
  otp_code          String?
  otp_expires_at    DateTime?
  otp_attempts      Int        @default(0)
  otp_last_sent_at  DateTime?  @db.Timestamptz
  otp_resend_available_at DateTime? @db.Timestamptz
  created_at        DateTime   @default(now()) @db.Timestamptz

  fields            Field[]
  bookings          Booking[]
  refresh_tokens    RefreshToken[]

  @@index([otp_code])
}

model Field {
  id             String      @id @default(uuid()) @db.Uuid
  owner_id       String      @db.Uuid
  name           String
  location       String
  description    String?
  images         String[]
  price_per_hour Decimal     @db.Decimal
  search_vector  Unsupported("tsvector")?
  type           FieldType   @default(FUTSAL)
  is_active      Boolean     @default(false)
  created_at     DateTime    @default(now()) @db.Timestamptz
  updated_at     DateTime    @updatedAt

  owner          User        @relation(fields: [owner_id], references: [id])
  slots          FieldSlot[]
  bookings       Booking[]

  @@index([owner_id])
  @@index([location, is_active])
  @@index([search_vector], type: Gin, map: "idx_field_search_vector")
}

model FieldSlot {
  id             String    @id @default(uuid()) @db.Uuid
  field_id       String    @db.Uuid
  start_time     DateTime  @db.Time
  end_time       DateTime  @db.Time
  date           DateTime  @db.Date
  price_override Decimal?  @db.Decimal
  is_locked      Boolean   @default(false)
  created_at     DateTime  @default(now()) @db.Timestamptz

  field          Field     @relation(fields: [field_id], references: [id])
  bookings       Booking[]

  @@unique([field_id, date, start_time, end_time])
  @@index([field_id, date])
}

model Booking {
  id         String        @id @default(uuid()) @db.Uuid
  user_id    String        @db.Uuid
  field_id   String        @db.Uuid
  slot_id    String?       @db.Uuid
  date       DateTime      @db.Date
  start_time DateTime      @db.Time
  end_time   DateTime      @db.Time
  status     BookingStatus @default(PENDING)
  created_at DateTime      @default(now()) @db.Timestamptz
  updated_at DateTime      @updatedAt
  expires_at DateTime      @db.Timestamptz

  user       User          @relation(fields: [user_id], references: [id])
  field      Field         @relation(fields: [field_id], references: [id])
  slot       FieldSlot?    @relation(fields: [slot_id], references: [id])
  payments   Payment[]

  @@index([user_id, created_at])
  @@index([slot_id, status])
  @@index([field_id, date])
}

model Payment {
  id         String        @id @default(uuid()) @db.Uuid
  booking_id String        @db.Uuid
  amount     Decimal       @db.Decimal
  provider   String
  status     PaymentStatus @default(PENDING)
  created_at DateTime      @default(now()) @db.Timestamptz
  updated_at DateTime      @updatedAt

  booking    Booking       @relation(fields: [booking_id], references: [id])

  @@index([booking_id])
}

model RefreshToken {
  id            String   @id @default(uuid()) @db.Uuid
  user_id       String   @db.Uuid
  token_hash    String   @unique
  expires_at    DateTime @db.Timestamptz
  revoked_at    DateTime? @db.Timestamptz
  last_used_at  DateTime? @db.Timestamptz
  created_at    DateTime @default(now()) @db.Timestamptz

  user          User     @relation(fields: [user_id], references: [id])

  @@index([user_id, expires_at])
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum FieldType {
  FUTSAL
  BADMINTON
  BASKETBALL
  VOLLEYBALL
  TENNIS
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
}