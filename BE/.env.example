# ===========================================
# FieldNow Backend — Environment Variables
# ===========================================
# Copy this file to .env and fill in your values.
# Variables marked [REQUIRED] will crash the app if missing.

# --- Core ---
NODE_ENV=development
PORT=5000

# --- Database [REQUIRED] ---
DATABASE_URL="postgresql://user:password@localhost:5432/fieldnow?schema=public"

# --- Supabase Storage (Image Upload) ---
# Get from: Supabase Dashboard → Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Name of the Storage bucket you created (must be Public)
SUPABASE_STORAGE_BUCKET=field-images

# --- Auth [REQUIRED] ---
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN=1d

# --- Redis (BullMQ + Distributed Locking) ---
REDIS_URL="redis://localhost:6379"

# --- CORS ---
# Comma-separated origins allowed in staging/production.
# Leave empty or omit for allow-all in development.
CORS_ORIGIN=

# --- Email (Phase 3) ---
# Values: ethereal | smtp | sendgrid
EMAIL_PROVIDER=smtp
# --- SMTP settings (use when EMAIL_PROVIDER=smtp) ---
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_SECURE=false # true for 465
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-pass
# Optional: default from address used by the worker
MAIL_FROM="FieldNow System" <noreply@fieldnow.com>

# Required if EMAIL_PROVIDER=sendgrid
# SENDGRID_API_KEY=

# --- Payment (Phase 4) ---

#VNPAY
PAYMENT_PROVIDER=vnpay
VNP_TMNCODE=TEST1234
VNP_HASHSECRET=TESTSECRET1234567890
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://localhost:5000/api/v1/payments/vnpay-return
