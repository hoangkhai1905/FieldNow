# BullMQ Dashboard Configuration

# Redis connection
# Option 1: Use Upstash (preferred for cloud)
REDIS_URL=redis://:your-password@your-host:port

# Option 2: Use local Redis (for development)
# Comment out REDIS_URL and uncomment below:
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# Dashboard port
PORT=3001
